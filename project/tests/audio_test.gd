extends TestCase
## Phase 11 audio: every sound is our own synthesized content, the bank is complete, and the
## AudioDirector turns gameplay events into the right cues, music and ambience.

const BANK := "res://data/audio/sound_bank.tres"


func _profile() -> void:
	PlayerProfile.path = "user://test_profile_phase11_audio.json"
	if FileAccess.file_exists(PlayerProfile.path):
		DirAccess.remove_absolute(ProjectSettings.globalize_path(PlayerProfile.path))


func _done() -> void:
	PlayerProfile.path = PlayerProfile.DEFAULT_PATH


func test_bank_has_every_cue_with_real_sound() -> void:
	var bank := load(BANK) as SoundBank
	for id in ["swing", "hit", "hit_heavy", "hurt", "dodge", "jump", "land", "step", "talisman", "telegraph",
			"boss_roar", "boss_attack", "part_break", "eruption", "pickup", "checkpoint", "lightning", "gust",
			"splash", "vent", "victory", "timer_warning", "death"]:
		var c := bank.cue(StringName(id))
		check(c != null and c.stream != null and c.stream.get_length() > 0.03, "%s has a sound" % id)
	for key in ["verdant_canopy", "emberwild", "moonfen", "stormcrag"]:
		var a := bank.ambience.get(key) as AudioStreamWAV
		check(a != null and a.loop_mode == AudioStreamWAV.LOOP_FORWARD and a.get_length() >= 6.0, "%s ambience loops" % key)
		check(ResourceLoader.exists("res://scenes/biomes/%s.tscn" % key), "%s matches a biome scene" % key)
	for m in [bank.music_explore, bank.music_boss]:
		check(m is AudioStreamWAV and (m as AudioStreamWAV).loop_mode == AudioStreamWAV.LOOP_FORWARD, "music loops")


func test_audio_is_original_and_logged() -> void:
	var ledger := FileAccess.get_file_as_string("res://../assets/ASSET_LEDGER.md")
	if ledger == "":
		ledger = FileAccess.get_file_as_string(ProjectSettings.globalize_path("res://").path_join("../assets/ASSET_LEDGER.md"))
	check(ledger.contains("generate_audio.gd"), "ledger records the audio as generated by our own tool")
	for d in ["sfx", "ambience", "music"]:
		for f in DirAccess.get_files_at("res://assets/audio/" + d):
			check(f.ends_with(".res") or f.ends_with(".import"), "%s/%s is a generated resource" % [d, f])


func test_buses_exist_and_volume_settings_apply() -> void:
	for bus in ["Music", "SFX", "Ambience"]:
		check(AudioServer.get_bus_index(bus) >= 0, "%s bus" % bus)
	GameSettings.path = "user://test_settings_phase11_audio.cfg"
	GameSettings.load_settings()
	GameSettings.set_volume("Music", 0.25)
	check_near(AudioServer.get_bus_volume_db(AudioServer.get_bus_index("Music")), linear_to_db(0.25), 0.01, "music volume applied")
	GameSettings.set_volume("Music", 0.0)
	check(AudioServer.is_bus_mute(AudioServer.get_bus_index("Music")), "zero mutes")
	GameSettings.set_volume("Music", 0.7)
	GameSettings.path = GameSettings.DEFAULT_PATH
	GameSettings.load_settings()


func test_expedition_plays_ambience_music_and_player_sounds() -> void:
	_profile()
	var main := instantiate("res://scenes/main/expedition_moonfen.tscn")
	var m := main.get_node("Expedition") as ExpeditionManager
	var p := main.get_node("Player") as PlayerController
	await physics_frames(20)
	var a := m.audio
	var bank := load(BANK) as SoundBank
	check(a.ambience.playing and a.ambience.stream == bank.ambience["moonfen"], "Moonfen ambience")
	check(a.music.playing and a.music.stream == bank.music_explore, "exploration music on the route")
	press("jump")
	await physics_frames(6)
	release("jump")
	await physics_frames(70)
	check(a.count(&"jump") == 1 and a.count(&"land") >= 1, "jump and land sounds")
	press("move_forward")
	await physics_frames(90)
	release("move_forward")
	check(a.count(&"step") >= 3, "footsteps while running (%d)" % a.count(&"step"))
	BotHelpers.tap(self, "attack_light")
	await physics_frames(20)
	check(a.count(&"swing") == 1, "blade swing")
	BotHelpers.tap(self, "dodge")
	await physics_frames(20)
	check(a.count(&"dodge") == 1, "roll")
	_done()


func test_boss_telegraphs_are_heard_and_the_arena_switches_music() -> void:
	_profile()
	var main := instantiate("res://scenes/main/main.tscn")
	var m := main.get_node("Expedition") as ExpeditionManager
	var boss := main.get_node("Level/Boss") as BossController
	await physics_frames(10)
	(main.get_node("Player") as PlayerController).global_position = Vector3(0, 0.5, -104)
	await physics_frames(10)
	check(m.audio.music.stream == (load(BANK) as SoundBank).music_boss, "taiko drums in the arena")
	await physics_frames(int(boss.definition.intro_time * 60.0) + 10)
	check(m.audio.count(&"boss_roar") >= 1, "the beast roars when it wakes")
	var before := m.audio.count(&"telegraph")
	boss.debug_force_attack(boss.definition.attacks[0].id)
	await physics_frames(5)
	check(m.audio.count(&"telegraph") == before + 1, "every telegraph has a warning sound")
	for i in 9:
		var hit := DamageInfo.new()
		hit.amount = 30.0
		(boss.get_node("Visual/AntlerHurtbox") as Hurtbox).receive(hit)
	await physics_frames(3)
	check(m.audio.count(&"part_break") == 1, "part break crack")
	_done()


func test_hazards_have_sounds() -> void:
	_profile()
	var main := instantiate("res://scenes/main/expedition_stormcrag.tscn")
	var m := main.get_node("Expedition") as ExpeditionManager
	await physics_frames(5)
	var caller := main.get_node("Level/Hazards/StormCaller") as StormCaller
	caller.struck.emit(Vector3(0, 4, -20), false)
	check(m.audio.count(&"lightning") == 1, "lightning crack")
	var gust := main.get_node("Level/Hazards/GaleGust") as GustZone
	(main.get_node("Player") as PlayerController).global_position = Vector3(0, 0.3, -47)
	for i in int(gust.cycle_length() * 60.0) + 10:
		await tree.physics_frame
		if m.audio.count(&"gust") > 0:
			break
	check(m.audio.count(&"gust") >= 1, "wind warning sound before a gust")
	_done()
